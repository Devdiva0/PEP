    "        self.age=age\n",
    "\n",
    "    def display(self):\n",
    "        print(self.name,self.age,self.college)\n",
    "\n",
    "s1=student(\"Rahul\",20)\n",
    "s2=student(\"Amit\",21)\n",
    "\n",
    "s1.display()\n",
    "s2.display()"
